<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4/v5 source for the Windows .msi installer. Installs per-user (no
  admin rights / UAC prompt needed) into %LocalAppData%\Programs, adds a
  Start Menu shortcut, and registers a normal uninstall entry automatically
  (standard MSI behavior). See claude-usage-widget-plan.md section 10.

  Pinned to WiX v5 (pre-6): v6+ added an Open Source Maintenance Fee EULA
  gate that isn't appropriate to auto-accept in CI for a company-adjacent
  project. Build (also see .github/workflows/release.yml):
    dotnet tool install (with the actual double-dash flag) global wix, version 5.0.2
    wix extension add WixToolset.UI.wixext/5.0.2
    wix build installer/ClaudeUsageWidget.wxs, passing SourceExe=dist/ClaudeUsageWidget.exe
    and ProductVersion=0.1.0, arch x64, extension WixToolset.UI.wixext, output ClaudeUsageWidget.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Claude Usage Widget"
           Manufacturer="Claude Usage Widget"
           Version="$(ProductVersion)"
           UpgradeCode="7c6b1b2b-9c7e-4a5a-9d0e-2c6b4b8d1a11"
           Compressed="yes"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Claude Usage Widget is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="ClaudeUsageWidget" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuSubfolder" Name="Claude Usage Widget" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Claude Usage Widget" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="a1e6c9f0-4b1a-4b2a-9b3a-1f2e3d4c5b6a">
      <File Id="ClaudeUsageWidgetEXE" Source="$(SourceExe)" KeyPath="yes" />
    </Component>

    <Component Id="ApplicationShortcut" Directory="ProgramMenuSubfolder" Guid="b2f7d0a1-5c2b-4c3b-8c4b-2a3b4c5d6e7f">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="Claude Usage Widget"
                Target="[INSTALLFOLDER]ClaudeUsageWidget.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanUpShortcut" Directory="ProgramMenuSubfolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ClaudeUsageWidget" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
  </Package>
</Wix>
